    <Build Include="Users\Tables\Roles.sql" />
    <Build Include="Users\Tables\UserLogs.sql" />
    <Build Include="Users\Tables\UserRoles.sql" />
    <Build Include="Users\Tables\Users.sql" />
    <Build Include="Files\Tables\UploadedFiles.sql" />
  </ItemGroup>
  <ItemGroup>
